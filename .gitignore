.idea/
.DS_Store
Thumbs.db

# Scratch.
.dsh-probe.txt

# Downloaded papers (large, kept locally).
docs/papers/*.pdf
# Offline release bundle, for machines that cannot reach GitHub.
release.bundle
*.bundle

# Model weights and throwaway environments (GB scale).
models/
.venv-gpu/
# The torch CUDA wheel and its download shards are too large to commit.
tools/tmp_wheel/
*.whl

# Local build caches and publication review intermediates.
.cache/
tmp/

