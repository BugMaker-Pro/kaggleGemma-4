# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Data is large and stays out of git -- except the JSONL the audit reads.
# Use `data/*` and not `data/`: excluding the directory itself would stop git
# from ever looking inside it, and the exemptions below would never fire.
data/*
!data/gold_symbols.jsonl
!data/swebench_lite.jsonl
!data/ablation.jsonl
!data/experiment_v3.jsonl
!data/experiment_ff.jsonl
!data/experiment_fr2.jsonl
!data/experiment_ev.jsonl
!data/experiment_body.jsonl
!data/experiment_combo2.jsonl
!data/rerank_full_1024.jsonl
!data/gold_fixed.jsonl
!data/gold_impact.json
!data/features.jsonl
!data/features_full.jsonl
!data/combo_ltr.jsonl
!data/combo_ltr_full.jsonl
!data/combo_ltr_orders_full.jsonl
!data/body_ablation.jsonl
!data/body_evidence.jsonl
!data/body_rank_scores.jsonl
!data/context_cost.jsonl
!data/dense_scores.jsonl
!data/embed_full_lite.jsonl
!data/issue_evidence.jsonl
!data/power_analysis.json

# Snapshots, wheels and archives are re-downloadable, never committed.
snapshots/
wheels/
*.tgz
*.zip
!submission.zip

# Experiment output.
runs/
traces/
results/
*.log

# Paper build products; the figures that ship with the paper are exempt.
paper/build/
paper/*.aux
paper/*.pdf
!paper/fig*.pdf
# The submitted PDF must be tracked: Project Links point at it.
!paper/submission.pdf

# Editor and OS noise.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch.
.dsh-probe.txt

# Downloaded papers (large, kept locally).
docs/papers/*.pdf
# Offline release bundle, for machines that cannot reach GitHub.
release.bundle
*.bundle

# Model weights and throwaway environments (GB scale).
models/
.venv-gpu/
# The torch CUDA wheel and its download shards are too large to commit.
tools/tmp_wheel/
*.whl

# Local build caches and publication review intermediates.
.cache/
tmp/

# Prospective topology-control follow-up: auditable inputs and per-task outputs.
!data/graph_controls.jsonl
!data/graph_controls_context.jsonl
!data/graph_controls.manifest.json
!data/graph_controls_summary.json
!data/embed_retrieval.jsonl
!data/swebench_full.jsonl
!data/graph_controls.portable.json
!data/graph_controls_tie_sensitivity.json
