# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# 数据（体积大，绝不入库）。用 data/* 而不是 data/，否则 git 不会进入该目录，
# 下面的例外规则就没有机会生效。
data/*
snapshots/
wheels/
*.tgz
*.zip
!submission.zip

# ...但发布用的四个结果文件要入库：没有它们，别人无法复算论文里的任何一个数字
!data/gold_symbols.jsonl
!data/swebench_lite.jsonl
!data/ablation.jsonl
!data/experiment_v3.jsonl
!data/experiment_ff.jsonl
!data/experiment_fr2.jsonl
!data/experiment_ev.jsonl
!data/experiment_body.jsonl
!data/experiment_combo2.jsonl

# 实验产物
runs/
traces/
results/
*.log

# 论文构建产物（图表例外：主图要跟随正文一起版本化）
paper/build/
paper/*.aux
paper/*.pdf
!paper/fig*.pdf

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 临时探针
.dsh-probe.txt

# 论文 PDF（体积大，本地保留）
docs/papers/*.pdf

# 模型权重与临时虚拟环境（GB 级，绝不入库）
models/
.venv-gpu/

