new file mode 100644
index 00000000..b8ed973a
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,12 @@
+from requests._types import SupportsRead
+from typing import Any
+
+class MockFile:
+    def __getattr__(self, name):
+        if name == "read":
+            return lambda length=None: b"data"
+        raise AttributeError(name)
+
+fp = MockFile()
+print(f"isinstance(fp, SupportsRead): {isinstance(fp, SupportsRead)}")
+print(f"hasattr(fp, 'read'): {hasattr(fp, 'read')}")
