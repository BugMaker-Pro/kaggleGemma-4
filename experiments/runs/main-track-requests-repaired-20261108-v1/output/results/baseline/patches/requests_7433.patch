new file mode 100644
index 00000000..35dbb63b
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,21 @@
+import requests
+from collections.abc import Iterable
+from typing import Mapping
+
+class ProxyStream:
+    def __init__(self, data):
+        self.data = data
+    def __getattr__(self, name):
+        if name == "__iter__":
+            return lambda: iter(self.data)
+        raise AttributeError(name)
+
+data = b"some data"
+stream = ProxyStream(data)
+
+print(f"Is instance of Iterable: {isinstance(stream, Iterable)}")
+print(f"Has __iter__: {hasattr(stream, '__iter__')}")
+
+prep = requests.Request("GET", "http://example.com", data=stream).prepare()
+print(f"Body: {prep.body}")
+print(f"Body position: {prep._body_position}")
