    def test_client_connection_close():
        stream = httpx.DuplexStream(
            b"HTTP/1.1 200 OK\r\n"
            b"Content-Length: 12\r\n"
            b"Content-Type: text/plain\r\n"
            b"\r\n"
            b"hello, world"
        )
    
