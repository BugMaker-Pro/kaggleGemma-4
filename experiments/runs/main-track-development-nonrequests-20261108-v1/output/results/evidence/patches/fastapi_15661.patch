+import sys
+import re
+from datetime import date
+from pathlib import Path
+import subprocess
+
+def update_version(version: str):
+    file_path = Path("fastapi/__init__.py")
+    if not file_path.exists():
+        print(f"Error: {file_path} not found.")
+        sys.exit(1)
+    content = file_path.read_text()
+    # Use a more specific regex to avoid matching other things
+    new_content = re.sub(r'^__version__\s*=\s*".*"', f'__version__ = "{version}"', content, flags=re.MULTILINE)
+    file_path.write_text(new_content)
+    print(f"Updated version in {file_path} to {version}")
+
+def update_release_notes(version: str):
+    file_path = Path("docs/en/docs/release-notes.md")
+    if not file_path.exists():
+        print(f"Error: {file_path} not found.")
+        sys.exit(1)
+    content = file_path.read_text()
+    today = date.today().isoformat()
+    new_header = f"## {version} ({today})\n\n### Refactors\n\n"
+    
+    # Find the first occurrence of a version header like ## 0.136.3 (2026-05-23)
+    # We want to insert the new one before it.
+    pattern = r"(## \d+\.\d+\.\d+ \(.*\))"
+    match = re.search(pattern, content)
+    if match:
+        start = match.start()
+        new_content = content[:start] + new_header + content[start:]
+        file_path.write_text(new_content)
+        print(f"Updated release notes with version {version}")
+    else:
+        print("Warning: Could not find existing version header in release notes.")
+
+def main():
+    if len(sys.argv) < 2:
+        print("Usage: python scripts/release.py <version>")
+        sys.exit(1)
+    
+    version = sys.argv[1]
+    update_version(version)
+    update_release_notes(version)
+    
+    print("Running tests...")
+    try:
+        result = subprocess.run([sys.executable, "-m", "pytest"], capture_output=True, text=True)
+        print(result.stdout)
+        print(result.stderr)
+        if result.returncode != 0:
+            print(f"Tests failed with exit code {result.returncode}")
+            sys.exit(result.returncode)
+    except FileNotFoundError:
+        print("pytest not found. Skipping tests.")
+    
+    print("Release preparation successful!")
+
+if __name__ == "__main__":
+    main()
